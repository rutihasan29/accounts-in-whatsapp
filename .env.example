# ===================================================
# News Voice / WhatsApp Business Ledger Bot Configuration
# ===================================================

# Gemini API Keys (for Classifier & AirCheck Audio Splicing)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_AUDIO_API_KEYS=key1,key2,key3
GEMINI_AUDIO_API_KEY=your_gemini_audio_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter Fallback (optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
LLM_PROVIDER=gemini

# Internal Staff Phone Numbers (e.g. 88017XXXXXXXX)
VA2_PHONE=8801XXXXXXXXX
VE3_PHONE=8801XXXXXXXXX

# Script Inactivity Timeout in milliseconds
SCRIPT_TIMEOUT_MS=120000

# Ngrok Public Mobile Tunnel Authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Official Dashboard & CRM Admin PIN (Default: 6700)
DASHBOARD_PIN=6700
